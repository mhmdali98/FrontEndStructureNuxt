{
  "name": "nuxt-admin-starter",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "dev:mock": "nuxt dev --dotenv .env.mock",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "preview:mock": "node --env-file=.env.mock .output/server/index.mjs",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . && node scripts/check-boundaries.mjs",
    "lint:fix": "eslint . --fix",
    "check:rtl": "node scripts/check-rtl.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "perf": "node scripts/perf.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --trace off",
    "analyze": "nuxt analyze",
    "new:feature": "node scripts/new-feature.mjs",
    "postinstall": "nuxt prepare",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@iconify-json/lucide": "^1.2.155",
    "@internationalized/date": "^3.12.4",
    "@nuxt/ui": "^4.12.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/colada": "^1.4.9",
    "@pinia/colada-nuxt": "^1.2.1",
    "@pinia/nuxt": "^1.0.3",
    "@tanstack/charts": "^1.5.0",
    "@vueuse/core": "14.4.0",
    "@vueuse/nuxt": "14.4.0",
    "nuxt": "^4.6.4",
    "nuxt-auth-utils": "~0.6.2",
    "pinia": "^4.1.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@nuxt/eslint": "^1.17.0",
    "@nuxt/test-utils": "^4.4.0",
    "@playwright/test": "^1.65.1",
    "@vitest/coverage-v8": "^5.1.0",
    "@vue/test-utils": "^2.6.0",
    "eslint": "^10.15.0",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lighthouse": "^13.6.0",
    "lint-staged": "^17.6.1",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
