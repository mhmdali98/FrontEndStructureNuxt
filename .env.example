# ── Required in production ─────────────────────────────────────────────
# Secret used by nuxt-auth-utils to seal the session cookie (>= 32 chars).
# Generate with: openssl rand -base64 32
NUXT_APP_SECRET=

# Base URL of your REST backend (server-side only, never exposed to the browser).
NUXT_API_BASE=http://localhost:8000/api

# ── Optional ───────────────────────────────────────────────────────────
# Use the built-in mock backend instead of NUXT_API_BASE.
NUXT_API_MOCK=false
# Serve /api/mock/** routes (also implied by NUXT_API_MOCK=true).
NUXT_MOCK_ROUTES=false
# Upstream request timeout in ms.
NUXT_API_TIMEOUT=15000
# Where backend tokens are kept: "cookie" (sealed session) or "storage" (server-side unstorage).
NUXT_AUTH_TOKEN_STORE=cookie
# Set to false ONLY for non-TLS intranet testing.
# NUXT_SESSION_COOKIE_SECURE=false

# Mock tuning
NUXT_MOCK_ACCESS_TTL=120
NUXT_MOCK_LATENCY_MS=150-500

# Public
NUXT_PUBLIC_APP_NAME=Nexus Admin
NUXT_PUBLIC_DEFAULT_LOCALE=en
NUXT_PUBLIC_DEMO_MODE=false
NUXT_PUBLIC_PREFERENCES_SYNC=false
